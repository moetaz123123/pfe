#!/bin/bash
PASS="{{ grafana_admin_password }}"
NAMESPACE="{{ monitoring_namespace }}"
GRAFANA_POD=$(kubectl get pods -n $NAMESPACE -l app.kubernetes.io/name=grafana \
  --no-headers -o custom-columns=":metadata.name" | head -1)

for i in $(seq 1 20); do
  STATUS=$(kubectl exec -n $NAMESPACE $GRAFANA_POD -c grafana -- \
    curl -sf -o /dev/null -w "%{http_code}" http://localhost:3000/api/health 2>/dev/null || echo "000")
  echo "Attempt $i - Grafana health: $STATUS"
  [ "$STATUS" = "200" ] && break
  sleep 5
done

kubectl exec -n $NAMESPACE $GRAFANA_POD -c grafana -- \
  curl -sf -X DELETE -u "admin:${PASS}" \
  http://localhost:3000/api/datasources/name/Loki 2>/dev/null || true

LOKI_URL="http://{{ loki_service_name }}.{{ monitoring_namespace }}.svc.cluster.local:{{ loki_port }}"
PAYLOAD="{\"name\":\"Loki\",\"type\":\"loki\",\"url\":\"${LOKI_URL}\",\"access\":\"proxy\",\"isDefault\":true,\"jsonData\":{}}"

RESULT=$(kubectl exec -n $NAMESPACE $GRAFANA_POD -c grafana -- \
  curl -sf -X POST -u "admin:${PASS}" \
  -H "Content-Type: application/json" \
  -d "$PAYLOAD" \
  http://localhost:3000/api/datasources 2>/dev/null)

echo "Datasource result: $RESULT"

LOKI_UID=$(kubectl exec -n $NAMESPACE $GRAFANA_POD -c grafana -- \
  curl -sf -u admin:${PASS} \
  http://localhost:3000/api/datasources/name/Loki 2>/dev/null \
  | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('uid','loki'))" 2>/dev/null || echo "loki")

echo "Loki datasource UID: $LOKI_UID"

kubectl exec -n $NAMESPACE $GRAFANA_POD -c grafana -- \
curl -sf -X POST -u admin:${PASS} \
  -H "Content-Type: application/json" \
  -d "{
    \"overwrite\": true,
    \"folderId\": 0,
    \"dashboard\": {
      \"uid\": \"kubernetes-audit\",
      \"title\": \"Kubernetes Audit Log\",
      \"timezone\": \"browser\",
      \"refresh\": \"30s\",
      \"time\": {\"from\": \"now-1h\", \"to\": \"now\"},
      \"panels\": [
        {
          \"id\": 1, \"type\": \"stat\", \"title\": \"Total Evenements (1h)\",
          \"gridPos\": {\"x\": 0, \"y\": 0, \"w\": 6, \"h\": 4},
          \"datasource\": {\"type\": \"loki\", \"uid\": \"${LOKI_UID}\"},
          \"targets\": [{\"expr\": \"sum(count_over_time({job=\\\"kubernetes-audit\\\", namespace!=\\\"\\\"}[1h]))\"}],
          \"fieldConfig\": {\"defaults\": {\"color\": {\"mode\": \"fixed\", \"fixedColor\": \"green\"}}}
        },
        {
          \"id\": 2, \"type\": \"stat\", \"title\": \"Requetes Refusees 403 (1h)\",
          \"gridPos\": {\"x\": 6, \"y\": 0, \"w\": 6, \"h\": 4},
          \"datasource\": {\"type\": \"loki\", \"uid\": \"${LOKI_UID}\"},
          \"targets\": [{\"expr\": \"sum(count_over_time({job=\\\"kubernetes-audit\\\", namespace!=\\\"\\\", statusCode=\\\"403\\\"}[1h]))\"}],
          \"fieldConfig\": {\"defaults\": {\"color\": {\"mode\": \"fixed\", \"fixedColor\": \"red\"}}}
        },
        {
          \"id\": 3, \"type\": \"stat\", \"title\": \"Acces Secrets (1h)\",
          \"gridPos\": {\"x\": 12, \"y\": 0, \"w\": 6, \"h\": 4},
          \"datasource\": {\"type\": \"loki\", \"uid\": \"${LOKI_UID}\"},
          \"targets\": [{\"expr\": \"sum(count_over_time({job=\\\"kubernetes-audit\\\", namespace!=\\\"\\\", resource=\\\"secrets\\\"}[1h]))\"}]
        },
        {
          \"id\": 4, \"type\": \"stat\", \"title\": \"Suppressions (1h)\",
          \"gridPos\": {\"x\": 18, \"y\": 0, \"w\": 6, \"h\": 4},
          \"datasource\": {\"type\": \"loki\", \"uid\": \"${LOKI_UID}\"},
          \"targets\": [{\"expr\": \"sum(count_over_time({job=\\\"kubernetes-audit\\\", namespace!=\\\"\\\", verb=\\\"delete\\\"}[1h]))\"}]
        },
        {
          \"id\": 5, \"type\": \"logs\", \"title\": \"Logs Audit en Live\",
          \"gridPos\": {\"x\": 0, \"y\": 4, \"w\": 24, \"h\": 12},
          \"datasource\": {\"type\": \"loki\", \"uid\": \"${LOKI_UID}\"},
          \"targets\": [{\"expr\": \"{job=\\\"kubernetes-audit\\\", namespace!=\\\"\\\"}\"}],
          \"options\": {\"showTime\": true, \"showLabels\": true, \"wrapLogMessage\": true}
        }
      ]
    }
  }" http://localhost:3000/api/dashboards/import

