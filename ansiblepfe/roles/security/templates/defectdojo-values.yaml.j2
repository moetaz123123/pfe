---
tag: "2.58.2"
imagePullPolicy: IfNotPresent
createSecret: false
createPostgresqlSecret: false
createValkeySecret: false

# Note: médias DefectDojo en emptyDir par défaut chart → pièces jointes perdues si pod recréé (lab OK)
django:
  ingress:
    enabled: false
  serviceType: ClusterIP
  resources:
    requests:
      cpu: 250m
      memory: 600Mi
    limits:
      cpu: "2"
      memory: 1500Mi
  env:
    DD_SESSION_COOKIE_SECURE: "False"
    DD_CSRF_COOKIE_SECURE: "False"
  uwsgi:
    resources:
      requests:
        memory: 1000Mi
      limits:
        memory: 1500Mi
    livenessProbe:
      initialDelaySeconds: 180
      failureThreshold: 15
      timeoutSeconds: 10
  nginx:
    resources:
      requests:
        memory: 256Mi
      limits:
        memory: 1000Mi
    startupProbe:
      initialDelaySeconds: 30
      failureThreshold: 60
      periodSeconds: 10
      timeoutSeconds: 10
    readinessProbe:
      failureThreshold: 10
      timeoutSeconds: 10
      periodSeconds: 10
    livenessProbe:
      failureThreshold: 10
      timeoutSeconds: 10

celery:
  worker:
    replicas: 1
    resources:
      limits:
        memory: 1000Mi

valkey:
  resources:
    requests:
      cpu: 300m
      memory: 512Mi
    limits:
      memory: 1000Mi

postgresql:
  resources:
    requests:
      cpu: 300m
      memory: 512Mi
    limits:
      memory: 1000Mi

