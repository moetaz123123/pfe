#!/bin/bash
PASS="{{ grafana_admin_password }}"
NAMESPACE="{{ monitoring_namespace }}"
GRAFANA_POD=$(kubectl get pods -n $NAMESPACE -l app.kubernetes.io/name=grafana \
  --no-headers -o custom-columns=":metadata.name" | head -1)

LOKI_UID=$(kubectl exec -n $NAMESPACE $GRAFANA_POD -c grafana -- \
  curl -sf -u admin:${PASS} \
  http://localhost:3000/api/datasources/name/Loki 2>/dev/null \
  | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('uid','loki'))" 2>/dev/null || echo "loki")

kubectl exec -n $NAMESPACE $GRAFANA_POD -c grafana -- \
curl -sf -X POST -u admin:${PASS} \
  -H "Content-Type: application/json" \
  -d "{
    \"overwrite\": true,
    \"folderId\": 0,
    \"dashboard\": {
      \"uid\": \"cluster-logs\",
      \"title\": \"Cluster Logs - Global Traffic\",
      \"timezone\": \"browser\",
      \"refresh\": \"10s\",
      \"time\": {\"from\": \"now-1h\", \"to\": \"now\"},
      \"panels\": [
        {
          \"id\": 1, \"type\": \"stat\", \"title\": \"Total Logs (last 1h)\",
          \"gridPos\": {\"x\": 0, \"y\": 0, \"w\": 6, \"h\": 4},
          \"datasource\": {\"type\": \"loki\", \"uid\": \"${LOKI_UID}\"},
          \"targets\": [{\"expr\": \"sum(count_over_time({job=\\\"kubernetes-cluster\\\", namespace!=\\\"\\\"}[1h]))\"}],
          \"fieldConfig\": {\"defaults\": {\"color\": {\"mode\": \"fixed\", \"fixedColor\": \"blue\"}}}
        },
        {
          \"id\": 2, \"type\": \"stat\", \"title\": \"Error Logs (1h)\",
          \"gridPos\": {\"x\": 6, \"y\": 0, \"w\": 6, \"h\": 4},
          \"datasource\": {\"type\": \"loki\", \"uid\": \"${LOKI_UID}\"},
          \"targets\": [{\"expr\": \"sum(count_over_time({job=\\\"kubernetes-cluster\\\", namespace!=\\\"\\\", level=\\\"ERROR\\\"}[1h]))\"}],
          \"fieldConfig\": {\"defaults\": {\"color\": {\"mode\": \"fixed\", \"fixedColor\": \"red\"}}}
        },
        {
          \"id\": 3, \"type\": \"stat\", \"title\": \"Logs Systeme Noeuds (1h)\",
          \"gridPos\": {\"x\": 12, \"y\": 0, \"w\": 6, \"h\": 4},
          \"datasource\": {\"type\": \"loki\", \"uid\": \"${LOKI_UID}\"},
          \"targets\": [{\"expr\": \"sum(count_over_time({job=\\\"node-system\\\"}[1h]))\"}],
          \"fieldConfig\": {\"defaults\": {\"color\": {\"mode\": \"fixed\", \"fixedColor\": \"purple\"}}}
        },
        {
          \"id\": 4, \"type\": \"logs\", \"title\": \"Live Cluster Logs\",
          \"gridPos\": {\"x\": 0, \"y\": 4, \"w\": 24, \"h\": 15},
          \"datasource\": {\"type\": \"loki\", \"uid\": \"${LOKI_UID}\"},
          \"targets\": [{\"expr\": \"{job=\\\"kubernetes-cluster\\\", namespace!=\\\"\\\"}\"}],
          \"options\": {\"showTime\": true, \"showLabels\": true, \"wrapLogMessage\": true, \"sortOrder\": \"Descending\"}
        }
      ]
    }
  }" http://localhost:3000/api/dashboards/import

