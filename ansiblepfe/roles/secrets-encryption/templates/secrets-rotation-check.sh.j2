#!/bin/bash
# ============================================================
# Secret Rotation Checker Script
# ============================================================
# Scans secrets for age and alerts on rotation needed

set -euo pipefail

LOG_FILE="/var/log/kubernetes/secrets-rotation.log"
ALERT_EMAIL="{{ smtp_from }}"
ROTATION_THRESHOLD_DAYS=30

log_message() {
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

log_message "Starting secrets rotation check..."

export KUBECONFIG=/etc/kubernetes/admin.conf

# Get all secrets and their age
SECRETS=$(kubectl get secrets -A -o json | jq -r '.items[] | 
  "\(.metadata.namespace) \(.metadata.name) \(.metadata.creationTimestamp)"')

NEEDS_ROTATION=""

while read -r namespace name creation_time; do
    if [ -z "$namespace" ]; then
        continue
    fi
    
    # Calculate age in days
    CREATION_DATE=$(date -d "$creation_time" +%s)
    NOW=$(date +%s)
    AGE_DAYS=$(( ($NOW - $CREATION_DATE) / 86400 ))
    
    if [ "$AGE_DAYS" -gt "$ROTATION_THRESHOLD_DAYS" ]; then
        log_message "WARNING: Secret $namespace/$name is $AGE_DAYS days old (threshold: $ROTATION_THRESHOLD_DAYS)"
        NEEDS_ROTATION="${NEEDS_ROTATION}Secret: $namespace/$name (Age: $AGE_DAYS days)\n"
    fi
done <<< "$SECRETS"

if [ -n "$NEEDS_ROTATION" ]; then
    log_message "Secrets requiring rotation detected!"
    echo -e "$NEEDS_ROTATION" >> "$LOG_FILE"
fi

# Count total encrypted secrets
TOTAL_SECRETS=$(kubectl get secrets -A --no-headers | wc -l)
log_message "Total encrypted secrets in cluster: $TOTAL_SECRETS"

# Verify encryption is enabled
ENCRYPTION_STATUS=$(kubectl api-resources 2>&1 | grep -i encrypt || echo "OK")
if [ -n "$ENCRYPTION_STATUS" ]; then
    log_message "Encryption status: $ENCRYPTION_STATUS"
else
    log_message "✓ Encryption verification passed"
fi

log_message "Secrets rotation check completed."
