---
# Audit Policy for Secrets
apiVersion: audit.k8s.io/v1
kind: Policy
rules:
  # Log all requests at Metadata level for secrets
  - level: RequestResponse
    resources:
      - group: ""
        resources: ["secrets"]
    omitStages:
      - RequestReceived

  # Log pod exec and attach
  - level: RequestResponse
    verbs: ["create"]
    resources:
      - group: ""
        resources: ["pods/exec", "pods/attach"]
    omitStages:
      - RequestReceived

  # Log authentication events
  - level: Metadata
    verbs: ["create", "update", "patch", "delete"]
    resources:
      - group: ""
        resources: ["secrets"]
    omitStages:
      - RequestReceived

  # Log secret deletion at high detail
  - level: RequestResponse
    verbs: ["delete"]
    resources:
      - group: ""
        resources: ["secrets"]
    omitStages:
      - RequestReceived

  # Catch-all
  - level: Metadata
    omitStages:
      - RequestReceived
