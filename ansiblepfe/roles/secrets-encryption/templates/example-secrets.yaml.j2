---
# Example application secrets - automatically created
apiVersion: v1
kind: Namespace
metadata:
  name: {{ app_namespace }}
  labels:
    secrets-protection: "enabled"
---
apiVersion: v1
kind: Secret
metadata:
  name: app-database-credentials
  namespace: {{ app_namespace }}
  labels:
    app: {{ app_name }}
    secret-type: database
type: Opaque
stringData:
  username: appuser
  password: "{{ lookup('password', '/dev/null length=32 chars=ascii_letters,digits') }}"
  host: "postgres.{{ app_namespace }}.svc.cluster.local"
  port: "5432"
  database: appdb
---
apiVersion: v1
kind: Secret
metadata:
  name: app-api-keys
  namespace: {{ app_namespace }}
  labels:
    app: {{ app_name }}
    secret-type: api-keys
type: Opaque
stringData:
  api_key: "{{ lookup('password', '/dev/null length=64 chars=ascii_letters,digits,hexdigits') }}"
  jwt_secret: "{{ lookup('password', '/dev/null length=64 chars=ascii_letters,digits') }}"
  encryption_key: "{{ lookup('password', '/dev/null length=32 chars=ascii_letters,digits') }}"
---
apiVersion: v1
kind: Secret
metadata:
  name: app-smtp-config
  namespace: {{ app_namespace }}
  labels:
    app: {{ app_name }}
    secret-type: smtp
type: Opaque
stringData:
  smtp_host: "{{ smtp_host }}"
  smtp_port: "{{ smtp_port }}"
  smtp_user: "{{ smtp_user }}"
  smtp_password: "{{ smtp_password }}"
  from_email: "{{ smtp_from }}"
---
apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin-secret
  namespace: {{ monitoring_namespace }}
  labels:
    app: grafana
    secret-type: admin-credentials
type: Opaque
stringData:
  admin-user: admin
  admin-password: "{{ grafana_admin_password }}"
---
apiVersion: v1
kind: Secret
metadata:
  name: tls-certificates
  namespace: {{ app_namespace }}
  labels:
    app: {{ app_name }}
    secret-type: tls
type: kubernetes.io/tls
data:
  tls.crt: 
  tls.key: LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tCk1JSUU3Z0lCQURBTkJna3Foa2lHOXcwQkFRRUZBQVNDQkswMkIzUGNTQWRESXQrd0F3SUJBZ0lCQVRBTkJna3EKaGtpRzl3MEJBUVNGQURCVE1Rb3dDQVFFQkFNK0NvRVlRalpXCllYSjVmSEJGUEFJQUJJQUJBV0F4TVFvd0NBRXNCQU0rQ29FWVFqWlcKWVhKNWZIQkZQQUlBQkk=
---
apiVersion: v1
kind: Secret
metadata:
  name: docker-registry-secret
  namespace: {{ app_namespace }}
  labels:
    secret-type: docker-registry
type: kubernetes.io/dockercfg
stringData:
  .dockercfg: |
    {
      "{{ registry_server | default('docker.io') }}": {
        "username": "{{ registry_user | default('') }}",
        "password": "{{ registry_password | default('') }}",
        "email": "{{ registry_email | default('') }}"
      }
    }
